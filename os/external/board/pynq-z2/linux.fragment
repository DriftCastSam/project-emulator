# Orbit console kernel fragment, on top of xilinx_zynq_defconfig.

# USB host, for the Bluetooth dongle.
CONFIG_USB=y
CONFIG_USB_SUPPORT=y
CONFIG_USB_CHIPIDEA=y
CONFIG_USB_CHIPIDEA_HOST=y
CONFIG_USB_CHIPIDEA_UDC=y
CONFIG_USB_ULPI=y
CONFIG_USB_ULPI_VIEWPORT=y
CONFIG_USB_GADGET=n
CONFIG_USB_STORAGE=y

# Bluetooth: HCI over USB, HID host.
CONFIG_BT=y
CONFIG_BT_BREDR=y
CONFIG_BT_LE=y
CONFIG_BT_HCIBTUSB=y
CONFIG_BT_HIDP=y
CONFIG_BT_RFCOMM=n
CONFIG_BT_BNEP=n

# Input: evdev is what the emulator reads.
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_JOYDEV=y
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_HID_MICROSOFT=y

# UIO for the video registers.
CONFIG_UIO=y
CONFIG_UIO_PDRV_GENIRQ=y

# Audio path for the on-board ADAU1761, used once the APU moves to the PL.
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_SOC=y
CONFIG_SND_SOC_ADAU1761_I2C=y
CONFIG_SND_SOC_ZYNQ=y
CONFIG_SND_SIMPLE_CARD=y

# Filesystems and SD.
CONFIG_MMC=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_OF_ARASAN=y
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_TMPFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# Networking, optional but useful for copying ROMs.
CONFIG_MACB=y
CONFIG_INET=y

# Keep the image small.
CONFIG_DEBUG_INFO=n
