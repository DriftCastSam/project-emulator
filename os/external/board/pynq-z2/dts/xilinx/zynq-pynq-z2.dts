// SPDX-License-Identifier: GPL-2.0
/*
 * TUL PYNQ-Z2, console configuration.
 *
 * Based on the mainline ZedBoard device tree (same PS peripherals), with
 * the reserved frame buffer and the UIO node for the video registers.
 */

/dts-v1/;
#include "zynq-7000.dtsi"

/ {
	model = "TUL PYNQ-Z2 console";
	compatible = "tul,pynq-z2", "xlnx,zynq-7000";

	aliases {
		ethernet0 = &gem0;
		serial0 = &uart1;
		mmc0 = &sdhci0;
	};

	memory@0 {
		device_type = "memory";
		reg = <0x0 0x20000000>;
	};

	reserved-memory {
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		/* 256x240 RGB565, written by the CPU and read by the PL. */
		orbit_fb: framebuffer@1f000000 {
			reg = <0x1f000000 0x40000>;
			no-map;
		};
	};

	chosen {
		bootargs = "console=ttyPS0,115200 root=/dev/mmcblk0p2 rw rootwait uio_pdrv_genirq.of_id=generic-uio";
		stdout-path = "serial0:115200n8";
	};

	/* Video registers, mapped by the fbdemo/emulator through /dev/uio0. */
	orbit_video: orbit-video@40000000 {
		compatible = "generic-uio";
		reg = <0x40000000 0x1000>;
		status = "okay";
	};

	usb_phy0: phy0 {
		compatible = "usb-nop-xceiv";
		#phy-cells = <0>;
	};
};

&clkc {
	ps-clk-frequency = <33333333>;
};

&gem0 {
	status = "okay";
	phy-mode = "rgmii-id";
	phy-handle = <&ethernet_phy>;

	ethernet_phy: ethernet-phy@0 {
		reg = <0>;
		device_type = "ethernet-phy";
	};
};

&sdhci0 {
	status = "okay";
};

&uart1 {
	status = "okay";
};

&usb0 {
	status = "okay";
	dr_mode = "host";
	usb-phy = <&usb_phy0>;
};
