#!/bin/sh
#
# The console owns the display. If a ROM is on the card, start the emulator;
# otherwise run the framebuffer demo so the video path is still exercised.

DAEMON=/usr/bin/orbit-nes
DEMO=/usr/bin/fbdemo
PIDFILE=/var/run/console.pid

case "$1" in
start)
	mkdir -p /roms /var/log

	ROM=$(ls /roms/*.nes 2>/dev/null | head -n 1)

	if [ -n "$ROM" ] && [ -x "$DAEMON" ]; then
		"$DAEMON" "$ROM" >/var/log/console.log 2>&1 &
		echo $! > "$PIDFILE"
	elif [ -x "$DEMO" ]; then
		"$DEMO" >/var/log/console.log 2>&1 &
		echo $! > "$PIDFILE"
	fi
	;;
stop)
	[ -f "$PIDFILE" ] && kill "$(cat "$PIDFILE")" 2>/dev/null
	rm -f "$PIDFILE"
	;;
restart|reload)
	"$0" stop
	"$0" start
	;;
esac
