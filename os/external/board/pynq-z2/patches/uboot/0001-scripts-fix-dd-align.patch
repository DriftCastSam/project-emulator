From: Orbit console build
Subject: [PATCH] scripts: give dd a cbs= when using conv=block

GNU coreutils rejects conv=block without cbs=N, which breaks the Zynq
SPL align step on current hosts. BusyBox dd accepts it. Set cbs to the
block size so both behave the same.

--- a/scripts/Makefile.xpl
+++ b/scripts/Makefile.xpl
@@ -257,7 +257,7 @@
 endif
 
 $(obj)/$(SPL_BIN)-align.bin: $(obj)/$(SPL_BIN).bin
-	@dd if=$< of=$@ conv=block,sync bs=4 2>/dev/null;
+	@dd if=$< of=$@ conv=block,sync bs=4 cbs=4 2>/dev/null;
 
 spl/boot.bin: $(obj)/$(SPL_BIN)-align.bin FORCE
 	$(call if_changed,mkimage)
