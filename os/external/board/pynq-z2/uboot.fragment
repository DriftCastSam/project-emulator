CONFIG_USE_BOOTCOMMAND=y
CONFIG_BOOTCOMMAND="fatload mmc 0:1 0x2000000 boot.scr; source 0x2000000"
CONFIG_BOOTDELAY=1

# Load the bitstream before Linux so the HDMI output is alive early.
CONFIG_CMD_FPGA=y
CONFIG_FPGA=y
CONFIG_FPGA_ZYNQ=y

CONFIG_CMD_FAT=y
CONFIG_CMD_SOURCE=y
CONFIG_CMD_BOOTM=y
CONFIG_CMD_GPIO=y
